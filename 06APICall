import requests

# Send en GET-forespørgsel til RandomUser API
response = requests.get('https://randomuser.me/api/')

# Konverter svardata til JSON-format
user_data = response.json()

# Udskriv hele JSON-objektet
print(user_data)


# Udskriv data
user = user_data['results'][0]

# Udskriv navn
print(user['name']['first'], user['name']['last'])